{
    "name": "joesama/webhook",
    "description": "Guzzle Base HTTP Request Wrapper",
    "license": "MIT",
    "authors": [
        {
            "name": "Joesama",
            "email": "joharijumali@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Joesama\\Webhook\\": "src/"
        },
        "classmap": [],
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Joesama\\Webhook\\Tests\\": "tests/",
            "Joesama\\Webhook\\Examples\\": "examples/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "v12.1.1",
        "guzzlehttp/guzzle": "^7.9",
        "nesbot/carbon": "^3.9"
    },
    "require-dev": {
        "orchestra/testbench": "^10.1",
        "pheromone/phpcs-security-audit": "^2.0",
        "phpstan/phpstan": "^2.1"
    },
    "extra": {
        "laravel": {
            "provider": [
                "Joesama\\Webhook\\Providers\\WebHookServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit tests/Feature/TestHook.php --display-phpunit-deprecations",
            "@php vendor/bin/phpunit tests/Feature/HookConnectorTest.php --display-phpunit-deprecations",
            "@php vendor/bin/phpunit tests/Unit/TestConfig.php --display-phpunit-deprecations"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse src tests --verbose --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}